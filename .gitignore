# 1. Bỏ qua thư mục Test (Không đẩy dữ liệu test/ảnh test lên)
tests/

# 2. Bỏ qua các file biên dịch Python (Rác hệ thống)
__pycache__/
*.pyc
*.pyo
*.pyd

# 3. Bỏ qua môi trường ảo (Virtual Environment)
.venv/
venv/
env/
ENV/

# 4. Bỏ qua file trọng số Model quá nặng (>100MB GitHub sẽ chặn)
*.pth
*.pt
*.weights

# 5. Bỏ qua dữ liệu Dataset (Rất nặng)
*flickr*

# 6. Bỏ qua các file hệ thống và cấu hình IDE
.idea/
.vscode/
.DS_Store

# 7. Log & Database (Nếu có)
*.log
*.sqlite
*.db